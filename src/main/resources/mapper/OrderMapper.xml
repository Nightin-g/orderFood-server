<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.orderfood.demos.web.mapper.OrderMapper">

    <!-- 这里可以添加一些公共的sql片段 -->
    <sql id="Base_Column_List">
        order_id, order_status, order_price, order_num, create_time, finish_time, user_id
    </sql>
    
    <!-- insert语句 -->
    <insert id="insert" parameterType="com.example.orderfood.demos.web.model.Order">
        INSERT INTO `order` (order_status, order_price, order_num, create_time, finish_time, user_id)
        VALUES (#{orderStatus}, #{orderPrice}, #{orderNum}, #{createTime}, #{finishTime}, #{userId})
    </insert>
    
    <!-- updateById -->
    <update id="updateById" parameterType="com.example.orderfood.demos.web.model.Order">
        UPDATE `order`
        SET order_status = #{orderStatus},
            order_price = #{orderPrice},
            finish_time = #{finishTime}
        WHERE order_id = #{orderId}
    </update>
    
    <!-- updateSelective语句模板 -->
    <update id="updateSelective" parameterType="com.example.orderfood.demos.web.model.Order">
        <!-- 具体的update语句由用户补充 -->
    </update>
    
    <!-- deleteById语句 -->
    <delete id="deleteById" parameterType="java.math.BigInteger">
        DELETE FROM `order` WHERE order_id = #{orderId}
    </delete>
    
    <!-- selectById语句 -->
    <select id="selectById" parameterType="java.math.BigInteger" resultType="com.example.orderfood.demos.web.model.Order">
        SELECT <include refid="Base_Column_List" />
        FROM `order`
        WHERE order_id = #{orderId}
    </select>
    
    <!-- selectAll语句 -->
    <select id="selectAll" resultType="com.example.orderfood.demos.web.model.Order">
        SELECT <include refid="Base_Column_List" />
        FROM `order`
    </select>
    
    <!-- selectByExample语句模板 -->
    <select id="selectByExample" parameterType="com.example.orderfood.demos.web.model.Order" resultType="com.example.orderfood.demos.web.model.Order">
        <!-- 具体的select语句由用户补充 -->
    </select>

    <!-- 根据用户ID查询订单列表 -->
    <select id="selectByUserId" parameterType="java.math.BigInteger" resultType="com.example.orderfood.demos.web.model.Order">
        SELECT <include refid="Base_Column_List" />
        FROM `order`
        WHERE user_id = #{userId}
        ORDER BY create_time DESC
    </select>

</mapper>